# Defina na Railway; nunca publique segredos no GitHub
DATABASE_URL=postgres://localhost/socio
SETUP_TOKEN=gerar-token-aleatorio-de-pelo-menos-32-caracteres
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
NODE_ENV=production

# WA-AKG Sócio: utilizar gateway separado do Prospector
# WA_AKG_BASE_URL=https://gateway-do-socio.exemplo
# WA_AKG_API_KEY=chave-servidor
# CHANNEL_ENCRYPTION_KEY=segredo-aleatorio-com-no-minimo-32-caracteres

# Fase 3 — Checkout exclusivamente no ambiente de TESTE do Stripe.
# Sem estas variáveis, a aprovação do pedido continua disponível,
# mas não há criação de sessão de pagamento.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SOCIO_PUBLIC_URL=https://seu-socio.up.railway.app


# ETAPA 4 — backup criptografado, somente por comando do operador.
# O servidor do Sócio NÃO grava backups automaticamente em produção.
# SOCIO_BACKUP_PASSPHRASE=segredo-aleatorio-longo-em-gerenciador-externo
# SOCIO_BACKUP_DIR=/caminho/privado
# SOCIO_BACKUP_CONFIRM=YES_ENCRYPTED_BACKUP
# SOCIO_BACKUP_ARCHIVE=/caminho/privado/socio-dump.enc
# SOCIO_RESTORE_TEST_DATABASE_URL=postgres://usuario:senha@localhost:5432/socio_restore_test_example
# SOCIO_RESTORE_CONFIRM=YES_DISPOSABLE_DATABASE


# Fase 5 — preparação de migração Supabase. Não ativar sem validação real.
# SOCIO_MAINTENANCE_MODE=1
# SOCIO_SOURCE_DATABASE_URL=postgres://... (segredo somente no operador)
# SOCIO_SUPABASE_DATABASE_URL=postgres://... (segredo somente no operador)
# SOCIO_DB_SCHEMA=socio_app (somente depois do cutover aprovado)
# SOCIO_VERIFIED_BACKUP=YES
# SOCIO_TARGET_EMPTY_CONFIRMED=YES
# SOCIO_WRITE_FREEZE_CONFIRMED=YES


# FASE 6 - Instagram profissional (não configure sem o aplicativo Meta autorizado)
# SOCIO_PUBLIC_URL=https://socio-app-production-762c.up.railway.app
# INSTAGRAM_APP_ID=Meta-App-ID
# INSTAGRAM_APP_SECRET=Meta-App-Secret (Railway somente; nunca frontend)
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=segredo-gerado-para-este-webhook
# INSTAGRAM_GRAPH_VERSION=v26.0
# Usa CHANNEL_ENCRYPTION_KEY já existente para derivar chave isolada AES-256-GCM


# Integrações open source / sem aplicativo Meta Developers próprio.
# Este endpoint deve ser o DNS *privado* do serviço aiograpi-rest no Railway;
# não use IP externo e não configure credenciais Instagram aqui.
# SOCIO_INSTAGRAM_LAB_URL=http://socio-instagram-lab.railway.internal:8000/
# A chave CHANNEL_ENCRYPTION_KEY protege também tokens Pipeboard e Google Scripts.
# SOCIO_PUBLIC_URL=https://socio-app-production-762c.up.railway.app
# Tokens Pipeboard são configurados por empresa na UI; nunca usar um token global.


# UX de conexão de um clique (Pipeboard Meta Ads / Google Ads)
# Usa SOCIO_PUBLIC_URL e CHANNEL_ENCRYPTION_KEY já existentes;
# o servidor descobre os endpoints OAuth DCR/CIMD via Pipeboard.
# Não há APP_ID, APP_SECRET, tokens Meta ou Google para preencher.

# Opcional: conexão oficial Instagram hospedada por Ayrshare Business/Enterprise
# A agência deve contratar/configurar a integração antes de ativar aos clientes.
# AYRSHARE_API_KEY=chave-privada-da-agencia
# AYRSHARE_SSO_DOMAIN=dominio-fornecido-no-onboarding
# AYRSHARE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Nunca cole esses segredos em Git, mensagens ou frontend.

# Conexão atual: Meta Ads por navegador remoto com API Anything, sem app Meta.
# Google Ads OAuth e Scripts foram desativados no Sócio; variáveis legadas de
# Google não devem ser configuradas nem usadas em novas instalações.
# API Anything no Sócio: usa CHANNEL_ENCRYPTION_KEY, sem app Meta.
SOCIO_META_BROWSER_ENABLED=true
SOCIO_META_BROWSER_DIR=data/meta-browser
SOCIO_META_BROWSER_MAX_WORKERS=2
SOCIO_META_BROWSER_ALLOW_WRITES=false
# BROWSER_EXECUTABLE_PATH=/caminho/para/chromium

# Direct official Meta Marketing API (not WhatsApp Cloud API).
# Confirm the Graph version supported by the app before deployment.
SOCIO_META_APP_ID=2827016234367972
# SOCIO_META_APP_SECRET=server-only-secret
# SOCIO_META_GRAPH_VERSION=vXX.0
# SOCIO_PUBLIC_URL=https://your-socio-host
# CHANNEL_ENCRYPTION_KEY=existing-server-key-at-least-32-characters

# Rastreio WhatsApp indicativo (links pré-preenchidos por anúncio).
# Habilitar somente após testar PostgreSQL e um canal WA-AKG autorizado.
# SOCIO_ATTRIBUTION_ENABLED=true
# Não faz envios, não edita anúncios e não comprova cliques Meta/vendas.

# Geração diária de snapshots de campanhas no próprio painel Sócio.
# É necessário homologar os relatórios e o armazenamento antes de habilitar.
# SOCIO_META_REPORTS_ENABLED=true
# Não envia mensagens WhatsApp nem altera campanhas da Meta.
