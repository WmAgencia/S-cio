# Defina na Railway; nunca publique segredos no GitHub
DATABASE_URL=postgres://localhost/socio
SETUP_TOKEN=gerar-token-aleatorio-de-pelo-menos-32-caracteres
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
NODE_ENV=production

# WA-AKG Sócio: utilizar gateway separado do Prospector
# WA_AKG_BASE_URL=https://gateway-do-socio.exemplo
# WA_AKG_API_KEY=chave-servidor
# CHANNEL_ENCRYPTION_KEY=segredo-aleatorio-com-no-minimo-32-caracteres

# Fase 3 — Checkout exclusivamente no ambiente de TESTE do Stripe.
# Sem estas variáveis, a aprovação do pedido continua disponível,
# mas não há criação de sessão de pagamento.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SOCIO_PUBLIC_URL=https://seu-socio.up.railway.app


# ETAPA 4 — backup criptografado, somente por comando do operador.
# O servidor do Sócio NÃO grava backups automaticamente em produção.
# SOCIO_BACKUP_PASSPHRASE=segredo-aleatorio-longo-em-gerenciador-externo
# SOCIO_BACKUP_DIR=/caminho/privado
# SOCIO_BACKUP_CONFIRM=YES_ENCRYPTED_BACKUP
# SOCIO_BACKUP_ARCHIVE=/caminho/privado/socio-dump.enc
# SOCIO_RESTORE_TEST_DATABASE_URL=postgres://usuario:senha@localhost:5432/socio_restore_test_example
# SOCIO_RESTORE_CONFIRM=YES_DISPOSABLE_DATABASE


# Fase 5 — preparação de migração Supabase. Não ativar sem validação real.
# SOCIO_MAINTENANCE_MODE=1
# SOCIO_SOURCE_DATABASE_URL=postgres://... (segredo somente no operador)
# SOCIO_SUPABASE_DATABASE_URL=postgres://... (segredo somente no operador)
# SOCIO_DB_SCHEMA=socio_app (somente depois do cutover aprovado)
# SOCIO_VERIFIED_BACKUP=YES
# SOCIO_TARGET_EMPTY_CONFIRMED=YES
# SOCIO_WRITE_FREEZE_CONFIRMED=YES
